# ==========================================
# CONFIGURACIÓN DEL SERVIDOR PRICEVISION AI
# ==========================================
PORT=4002
NODE_ENV=development

# ==========================================
# GOOGLE GEMINI API KEY
# Puedes obtener una clave gratuita en: https://aistudio.google.com/
# (También se puede ingresar directamente desde la interfaz web)
# ==========================================
GEMINI_API_KEY=

# Modelo predeterminado (económico y multimodal para visión)
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# SERVICIO DE TASAS BCV / DÓLAR
# ==========================================
BCV_API_URL=http://localhost:3003/api/v1/tipo-cambio
